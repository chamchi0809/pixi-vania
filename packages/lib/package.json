{
  "name": "pixi-vania",
  "version": "0.1.0",
  "description": "Tilemap level editor and .svlevel runtime for PixiJS v8 + Rapier2D. Auto-tiling, collision layers, entity types, localization.",
  "keywords": [
    "pixijs",
    "pixi",
    "rapier",
    "level-editor",
    "tilemap",
    "tiled",
    "ldtk",
    "2d"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chamchi0809/pixi-vania.git"
  },
  "homepage": "https://github.com/chamchi0809/pixi-vania#readme",
  "bugs": {
    "url": "https://github.com/chamchi0809/pixi-vania/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.svelte.json",
    "check": "node --disable-warning=ExperimentalWarning --experimental-strip-types check.ts"
  },
  "peerDependencies": {
    "@dimforge/rapier2d-compat": ">=0.20 <0.21",
    "pixi.js": "^8.6.0"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier2d-compat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dimforge/rapier2d-compat": "^0.20.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tabler/icons-svelte": "^3.44.0",
    "@types/node": "^26.1.2",
    "i-input-svelte": "^0.1.0",
    "pixi.js": "8.19.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  }
}
